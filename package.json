{
  "name": "falling-leaves",
  "version": "0.1.0",
  "description": "A lightweight, dependency-free canvas animation of falling autumn leaves. Works with vanilla JS and React.",
  "keywords": [
    "leaves",
    "autumn",
    "fall",
    "falling",
    "animation",
    "canvas",
    "snowfall",
    "react",
    "particles",
    "seasonal"
  ],
  "license": "MIT",
  "author": "Erin Kerr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernkerr/falling-leaves.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && npx --yes serve . -l 3000",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
